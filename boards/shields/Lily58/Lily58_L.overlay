#include "Lily58.dtsi"

&kscan0 {
    col-gpios
        = <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        , <&pro_micro 16 GPIO_ACTIVE_HIGH>
        , <&pro_micro 10 GPIO_ACTIVE_HIGH>
        ;
};

&left_encoder {
    status = "okay";
};

// SK6812MINI-E 时序调整（仅左手）
// 4MHz 原设定: T0H 250ns / T1H 750ns(规格上限) / 周期 2.0us
// 8MHz 新设定: T0H 250ns / T1H 500ns / 周期 1.0us，高低电平都在规格内(0.3us/0.6us ±0.15us)
&led_strip {
    spi-max-frequency = <8000000>;
    spi-one-frame = <0xF0>;  /* 11110000: H 500ns, L 500ns */
    spi-zero-frame = <0xC0>; /* 11000000: H 250ns, L 750ns */
};

// 数据脚改高推力，3.3V 推 SK6812 时边沿更陡、高电平更足
&spi3_default {
    group1 {
        nordic,drive-mode = <NRF_DRIVE_H0H1>;
    };
};
/ {
    chosen {
      zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
};
